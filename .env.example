# ── LLM / Embedding provider keys ────────────────────────────────────────
# At minimum you need DEEPSEEK_API_KEY (chunking, metadata extraction,
# retrieval agent, LLM reranker, generation) and one embedding provider key
# (GEMINI_API_KEY or OPENAI_API_KEY — see src/ingestion/embedder.py
# MODEL_CONFIGS for which models map to which provider).
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Vector store ──────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=rag-pipeline-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Optional per-component overrides ─────────────────────────────────────
# Every retrieval/generation config file can be overridden via env var
# instead of editing YAML directly. See each RAGPIPE_* mapping in
# src/retrieval/{hybrid_search,reranker,confidence,context_builder,
# metadata_filter,orchestrator}.py and src/generation/{config,prompt_builder}.py.
# Examples (all optional, uncomment to use):
# RAGPIPE_SEMANTIC_K=40
# RAGPIPE_RERANKER_BACKEND=cross_encoder
# RAGPIPE_CONFIDENCE_HIGH=0.75
# RAGPIPE_RETRIEVAL_TIMEOUT_MS=5000
